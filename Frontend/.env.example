# Copy to .env.local. Leave VITE_API_ENABLED off to run on local state only.
VITE_API_ENABLED=false
# Empty = same origin (Vite proxies /api and /audio to VITE_BACKEND in dev; Nginx does it in production).
VITE_API_URL=
VITE_BACKEND=http://localhost:4000
# Only with backend AUTH_DISABLED=true: the x-dev-user header to send until Auth0 is wired up.
VITE_DEV_USER=
